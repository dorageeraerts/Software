# Telescope-level 1phe calibration: all runs of a telescope share the same pedestal_N files,
# derived once from the benchmark ped_onephe_sk*.txt files shipped with the repo.
# This replaces the per-run `pedestal_analysis` rule in the reconstruction chain, so runs
# no longer need the PIEDISTALLI parse/prereco/pedestal_analysis steps.
rule pedestal_reader:
    container: '/user/abiolchi/muraves-sing.sif'
    input:
        script = '3_PedAna/PedestalReader.py',
        benchmark_files = lambda wildcards: expand(
            PEDESTAL_BENCHMARK_TEMPLATE.format(color=wildcards.color) + '/ped_onephe_sk{n}.txt',
            n=range(1, 17)
        )
    params:
        benchmark_dir = lambda wildcards: PEDESTAL_BENCHMARK_TEMPLATE.format(color=wildcards.color),
        output_base = lambda wildcards: f'{wildcards.output_path}/PEDESTAL/{wildcards.color}/{wildcards.version}',
        nBoards = 16,
        nChannels = 32
    output:
        stamp = '{output_path}/PEDESTAL/{color}/{version}/PEDESTAL_BENCHMARK_{color}.stamp',
        pedestal_files = expand(
            '{{output_path}}/PEDESTAL/{{color}}/{{version}}/{{color}}/pedestal_{n}', n=range(16)
        )
    shell:
        "python {input.script} "
        "--input-dir {params.benchmark_dir} "
        "--output-dir {params.output_base} "
        "--telescope {wildcards.color} "
        "--num-boards {params.nBoards} "
        "--num-channels {params.nChannels} "
        "--stamp-file {output.stamp}"


rule analyse:
    threads: THREADS
    container: '/user/abiolchi/muraves-sing.sif'
    input:
        script = "4_MainRecSof/MURAVES_reco.py",
        data_file = '{output_path}/PARSED/{color}/{version}/ADC_batch{batch_idx}.stamp',
        one_phe_files = "{output_path}/PEDESTAL/{color}/{version}/PEDESTAL_BENCHMARK_{color}.stamp",
        reco_parameters = RECO_PARAMETERS_FILE,
        spiroc_mapping = SPIROC_MAPPING_FILE,
        telescope_cfg = lambda wildcards: TELESCOPE_CFG_TEMPLATE.format(color=wildcards.color)
    output:
        output_filename = '{output_path}/RECONSTRUCTED/{color}/{version}/MURAVES_AnalyzedData_batch{batch_idx}.stamp',
    params:
        raw_base = f'{PNFS}/RAW_GZ',
        tracks_base = '.',
        pedestal_folder = lambda wildcards: f'{wildcards.output_path}/PEDESTAL/{wildcards.color}/{wildcards.version}/{wildcards.color}',
        reco_config_file = SELECTED_RECO_CONFIG,
        slow_control_prefix = SLOW_CONTROL_PREFIX,
        cluster_smearing_seed_arg = (
            f'--cluster-smearing-seed {CLUSTER_SMEARING_SEED}'
            if CLUSTER_SMEARING_SEED is not None
            else ''
        ),
    shell:
        "python {input.script} {wildcards.color} "
        "-i {input.data_file} "
        "--pedestal-folder {params.pedestal_folder} "
        "-o {output.output_filename} "
        "--raw-base {params.raw_base} "
        "--tracks-base {params.tracks_base} "
        "--slow-control-prefix {params.slow_control_prefix} "
        "--spiroc-mapping-file {input.spiroc_mapping} "
        "--telescope-config-file {input.telescope_cfg} "
        "--base-config {input.reco_parameters} "
        "--config {params.reco_config_file} "
        "{params.cluster_smearing_seed_arg} "
        "--write-root "
        "-th {threads} "
        "-l {log_on_console} "
        "-v {verbose} "
        "-ow {overwrite_outputs}"




